{
  "name": "living-heritage",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @lh/web dev",
    "build": "pnpm --filter @lh/web build",
    "preview": "pnpm --filter @lh/web preview",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --fail-on error",
    "check-env": "node scripts/check-public-env.mjs",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "check:migrations": "node scripts/check-migrations-immutable.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "supabase": "2.120.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
